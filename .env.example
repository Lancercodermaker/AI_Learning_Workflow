# Provider-neutral HTTP gateway configuration. Keep real keys in .env only.
AI_PROVIDER=deepseek
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# Local ASR fallback. Keep model weights and media outside Git.
ASR_ENABLED=true
ASR_PYTHON=
ASR_MODEL=Qwen/Qwen3-ASR-0.6B
ASR_ALIGNER=Qwen/Qwen3-ForcedAligner-0.6B
ASR_LANGUAGE=Chinese
ASR_DEVICE=auto
ASR_TIMEOUT_MS=1800000
